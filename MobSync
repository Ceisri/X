#version 1.0.0.3
# MobSync.gd
extends Node
var _mobs := {}
var _cache_built := false
export var sync_rate := 0.09
export var cache_rebuild_interval := 2.0
var _timer := 0.0
var _cache_timer := 0.0
func _ready() -> void:
	get_tree().connect("network_peer_connected", self, "_on_peer_connected")
func _physics_process(delta:float) -> void:
	if get_tree().network_peer == null:
		return
	_cache_timer += delta
	if !_cache_built or _cache_timer >= cache_rebuild_interval:
		_cache_timer = 0.0
		_buildCache()
	if get_tree().is_network_server():
		_timer += delta
		if _timer >= sync_rate:
			_timer = 0.0
			_broadcastMobs(get_tree().get_network_connected_peers())
func _buildCache() -> void:
	_mobs.clear()
	for mob in get_tree().get_nodes_in_group("Entity"):
		if !is_instance_valid(mob):
			continue
		if !("movement_mode" in mob):
			continue
		_mobs[_mobKey(mob)] = mob
	_cache_built = _mobs.size() > 0
func _mobKey(mob:Node) -> String:
	var world = _getMobWorld(mob)
	if world:
		return world.world_id + ":" + str(world.get_path_to(mob))
	return str(mob.get_path())
func _getWorldNode() -> Node:
	var worlds = get_tree().get_nodes_in_group("World")
	if worlds.size() > 0:
		return worlds[0]
	return null
	
	
func _getMobWorld(mob:Node) -> Node:
	var n = mob.get_parent()
	while n:
		if n.is_in_group("World") and "world_id" in n:
			return n
		n = n.get_parent()
	return null





	
func _on_peer_connected(id:int) -> void:
	if !get_tree().is_network_server():
		return
	call_deferred("_deferredSendMobBatch", id)

func _deferredSendMobBatch(id:int) -> void:
	if !get_tree().is_network_server():
		return
	if !get_tree().get_network_connected_peers().has(id):
		return
	_buildCache()
	var payload = _buildPayload()
	if !payload.empty():
		rpc_id(id, "receiveMobBatch", payload)




export var full_sync_interval := 10 # send stats/cooldowns/aggro every 10th tick (~1s) instead of every tick
var _tick_count := 0

func _broadcastMobs(peer_ids:Array) -> void:
	if !_cache_built or peer_ids.empty():
		return
	_tick_count += 1
	var send_full = (_tick_count % full_sync_interval == 0)
	var payload = _buildPayload(send_full)
	if payload.empty():
		return
	for id in peer_ids:
		rpc_unreliable_id(id, "receiveMobBatch", payload)

