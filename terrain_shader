shader_type spatial;
render_mode async_visible,blend_mix,depth_draw_opaque,cull_back,diffuse_burley,specular_schlick_ggx,unshaded;
uniform vec4 albedo : hint_color;

uniform sampler2D texture_mask;

uniform float lod2_distance : hint_range(0, 1000) = 40.0;
uniform float lod3_distance : hint_range(0, 1000) = 90.0;
varying float camera_distance;

uniform sampler2D black_texture : hint_albedo;
uniform sampler2D black_texture_lod2 : hint_albedo;
uniform sampler2D black_texture_lod3 : hint_albedo;
uniform vec2 black_texture_scale=vec2(1.0);
uniform bool black_texture_no_tile=true;
uniform vec3 black_triplanar_scale=vec3(0.08);
uniform vec3 cliff_scale=vec3(0.08);

uniform sampler2D white_texture : hint_albedo;
uniform sampler2D white_texture_lod2 : hint_albedo;
uniform sampler2D white_texture_lod3 : hint_albedo;
uniform vec2 white_texture_scale=vec2(1.0);
uniform bool white_texture_no_tile=true;

uniform sampler2D blue_texture : hint_albedo;
uniform sampler2D blue_texture_lod2 : hint_albedo;
uniform sampler2D blue_texture_lod3 : hint_albedo;
uniform vec2 blue_texture_scale=vec2(1.0);
uniform bool blue_texture_no_tile=true;

uniform sampler2D yellow_texture : hint_albedo;
uniform sampler2D yellow_texture_lod2 : hint_albedo;
uniform sampler2D yellow_texture_lod3 : hint_albedo;
uniform vec2 yellow_texture_scale=vec2(1.0);
uniform bool yellow_texture_no_tile=true;

uniform sampler2D green_texture : hint_albedo;
uniform sampler2D green_texture_lod2 : hint_albedo;
uniform sampler2D green_texture_lod3 : hint_albedo;
uniform vec2 green_texture_scale=vec2(1.0);
uniform bool green_texture_no_tile=true;

uniform sampler2D red_texture : hint_albedo;
uniform sampler2D red_texture_lod2 : hint_albedo;
uniform sampler2D red_texture_lod3 : hint_albedo;
uniform vec2 red_texture_scale=vec2(1.0);
uniform bool red_texture_no_tile=true;

uniform float specular;
uniform float metallic;
uniform float roughness:hint_range(0.0,1.0);
uniform float point_size:hint_range(0.0,128.0);
float hash(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453123);}

vec2 rotate90(vec2 uv,float r){
	if(r<0.25)return uv;
	if(r<0.5)return vec2(uv.y,1.0-uv.x);
	if(r<0.75)return vec2(1.0-uv.x,1.0-uv.y);
	return vec2(1.0-uv.y,uv.x);
}

vec4 sample_no_tile(sampler2D tex,vec2 uv,vec2 scale){
	uv*=scale;

	vec2 tile1=floor(uv),local1=fract(uv);
	float r1=hash(tile1);
	vec2 rot1=rotate90(local1,r1);
	if(hash(tile1+17.3)>0.5)rot1.x=1.0-rot1.x;
	if(hash(tile1+53.7)>0.5)rot1.y=1.0-rot1.y;
	vec4 c1=texture(tex,tile1+rot1);
	c1.rgb*=mix(0.97,1.03,hash(tile1+91.4));

	vec2 uv2=uv+vec2(0.37,0.61);
	vec2 tile2=floor(uv2),local2=fract(uv2);
	float r2=hash(tile2+127.0);
	vec2 rot2=rotate90(local2,r2);
	if(hash(tile2+201.0)>0.5)rot2.x=1.0-rot2.x;
	if(hash(tile2+317.0)>0.5)rot2.y=1.0-rot2.y;
	vec4 c2=texture(tex,tile2+rot2);
	c2.rgb*=mix(0.97,1.03,hash(tile2+411.0));

	// Each grid has a hard discontinuity at its own tile borders (the
	// rotation/flip differs tile-to-tile). Previously only grid1's edge
	// was checked, so grid2's seams showed through uncovered. Track
	// both grids' distance-to-edge and always favor whichever grid is
	// currently farther from its own seam -- that grid's seam-free
	// sample covers for the other one's discontinuity.
	float edge1=min(min(local1.x,1.0-local1.x),min(local1.y,1.0-local1.y));
	float edge2=min(min(local2.x,1.0-local2.x),min(local2.y,1.0-local2.y));
	float safety=edge2/(edge1+edge2+1e-4);

	// Keep the original per-tile hash variation when we're safely away
	// from both grids' edges; let 'safety' take over as either grid
	// approaches its own seam.
	vec2 blend_uv=uv*0.35;
	float variation=mix(hash(floor(blend_uv)),hash(floor(blend_uv+vec2(5.37,8.21))),0.5);
	variation=smoothstep(0.25,0.75,variation);
	float nearEdge=1.0-smoothstep(0.0,0.35,min(edge1,edge2));
	float blend=mix(variation,safety,nearEdge);

	return mix(c1,c2,blend);
}

// LOD2/LOD3 skip the double-sample no-tile blend entirely -- that's the
// expensive part (2x texture() calls + hashing per pixel) and it's not
// worth paying for terrain far enough away that tiling repetition is
// imperceptible anyway. Straight texture() sampling on a cheaper LOD
// texture is enough at range.
// No-tile blending now applies at every LOD. It's a bit more expensive
// at range, but skipping it caused visible tile repetition on distant
// terrain, so we pay the cost uniformly instead.
vec4 sample_texture(sampler2D tex,sampler2D tex_lod2,sampler2D tex_lod3,vec2 uv,vec2 scale,bool no_tile){
	if(camera_distance>lod3_distance){
		return no_tile?sample_no_tile(tex_lod3,uv,scale):texture(tex_lod3,uv*scale);
	} else if(camera_distance>lod2_distance){
		return no_tile?sample_no_tile(tex_lod2,uv,scale):texture(tex_lod2,uv*scale);
	}
	return no_tile?sample_no_tile(tex,uv,scale):texture(tex,uv*scale);
}
vec4 sample_black_cliff(vec2 uv){
	vec2 cliff_uv=uv;

	cliff_uv.x*=cliff_scale.x;
	cliff_uv.y*=cliff_scale.y*cliff_scale.z;

	return sample_texture(black_texture,black_texture_lod2,black_texture_lod3,cliff_uv,vec2(1.0),black_texture_no_tile);
}


vec3 sample_mask_blur(vec2 uv){
	vec2 px=2.0/vec2(1024.0);
	vec3 c=vec3(0.0);
	float w=0.0;
	for(int y=-2;y<=2;y++)
	for(int x=-2;x<=2;x++){
		c+=texture(texture_mask,uv+vec2(float(x),float(y))*px).rgb;
		w+=1.0;
	}
	return c/w;
}
vec4 sample_black_triplanar(vec3 normal, vec3 position){
	vec3 blend=abs(normal);
	blend=vec3(pow(blend.x,4.0),pow(blend.y,4.0),pow(blend.z,4.0));
	blend/=blend.x+blend.y+blend.z;

	vec3 pos=position*black_triplanar_scale;

	vec4 x=texture(black_texture,pos.yz);
	vec4 y=texture(black_texture,pos.xz);
	vec4 z=texture(black_texture,pos.xy);

	return x*blend.x+y*blend.y+z*blend.z;
}
void vertex(){
	// VERTEX here is in view space (after MODELVIEW_MATRIX transform),
	// so its length is the distance from the camera -- same convention
	// as the mob LOD shader.
	camera_distance = length((MODELVIEW_MATRIX * vec4(VERTEX, 1.0)).xyz);
}
void fragment(){
	vec3 mask=sample_mask_blur(UV);

	vec4 tex_black=sample_black_cliff(UV);
	vec4 tex_white=sample_texture(white_texture,white_texture_lod2,white_texture_lod3,UV,white_texture_scale,white_texture_no_tile);
	vec4 tex_blue=sample_texture(blue_texture,blue_texture_lod2,blue_texture_lod3,UV,blue_texture_scale,blue_texture_no_tile);
	vec4 tex_yellow=sample_texture(yellow_texture,yellow_texture_lod2,yellow_texture_lod3,UV,yellow_texture_scale,yellow_texture_no_tile);
	vec4 tex_green=sample_texture(green_texture,green_texture_lod2,green_texture_lod3,UV,green_texture_scale,green_texture_no_tile);
	vec4 tex_red=sample_texture(red_texture,red_texture_lod2,red_texture_lod3,UV,red_texture_scale,red_texture_no_tile);

	float maxc=max(mask.r,max(mask.g,mask.b));
	float minc=min(mask.r,min(mask.g,mask.b));
	float gray=1.0-smoothstep(0.01,0.18,maxc-minc);
	float neutral=gray*(1.0-maxc);

	float white_purity=1.0-max(abs(mask.r-mask.g),max(abs(mask.r-mask.b),abs(mask.g-mask.b)));

	float wWhite=gray*maxc*smoothstep(0.75,1.0,white_purity);
	float wBlack=gray*(1.0-maxc);

	vec3 chroma=max(mask-vec3(minc),vec3(0.0));

	float wYellow=min(chroma.r,chroma.g);
	float wRed=max(chroma.r-wYellow,0.0);
	float wGreen=max(chroma.g-wYellow,0.0);
	float wBlue=chroma.b;

	float blackBlend=smoothstep(0.0,0.35,neutral);
	float whiteYellow=wWhite+wYellow;
	if(whiteYellow>0.0){
		float add=wRed*blackBlend;
		wWhite+=add*(wWhite/whiteYellow);
		wYellow+=add*(wYellow/whiteYellow);
		wRed-=add;
	}

	wRed*=1.0-gray;
	wGreen*=1.0-gray;
	wBlue*=1.0-gray;
	wYellow*=1.0-gray;

	float total=max(wBlack+wWhite+wBlue+wYellow+wGreen+wRed,0.00001);
	wBlack/=total;
	wWhite/=total;
	wBlue/=total;
	wYellow/=total;
	wGreen/=total;
	wRed/=total;

	vec4 albedo_tex=
		tex_black*wBlack+
		tex_white*wWhite+
		tex_blue*wBlue+
		tex_yellow*wYellow+
		tex_green*wGreen+
		tex_red*wRed;

	albedo_tex*=COLOR;

	ALBEDO=albedo.rgb*albedo_tex.rgb;
	METALLIC=metallic;
	ROUGHNESS=roughness;
	SPECULAR=specular;
}
